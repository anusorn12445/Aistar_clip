# AISTAR Talent OS — ตัวอย่าง environment variables
# คัดลอกไปตั้งใน Railway (แต่ละ service) — ห้าม commit ค่าจริง

# ── API service ─────────────────────────────────────────────
# DATABASE_URL: Railway Postgres จะสร้าง reference ให้ (${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:pass@host:5432/railway

# JWT_SECRET: สุ่มยาว ๆ (เช่น `openssl rand -base64 48`) — จำเป็น (getOrThrow)
JWT_SECRET=change-me-to-a-long-random-secret

# CORS_ORIGIN: โดเมนของ web (คั่นด้วย comma ได้) — ต้องตรงกับ URL ที่เปิดเว็บ
CORS_ORIGIN=https://aistar-web-production.up.railway.app

# STORAGE_DIR: ชี้ไปที่ Railway Volume ที่ mount ไว้ (เช่น /data/storage) — ไม่งั้นไฟล์หายทุก redeploy
STORAGE_DIR=/data/storage

# Anthropic (จะตั้งที่นี่ หรือกรอกในหน้า Settings ก็ได้ — DB ทับ env)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# PORT: Railway ฉีดให้อัตโนมัติ ไม่ต้องตั้งเอง

# ── Web service ─────────────────────────────────────────────
# NEXT_PUBLIC_API_URL: โดเมน public ของ API + /api — ต้องมีตอน BUILD (Next inline ค่านี้)
NEXT_PUBLIC_API_URL=https://aistar-api-production.up.railway.app/api
