# AISTAR Talent OS — Web (Next.js 16)
# build context = repo root (pnpm workspace)
FROM node:22-slim

RUN corepack enable
WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile

# ⚠️ NEXT_PUBLIC_* ถูก inline ตอน build — ต้องมีค่าตอน build ไม่ใช่แค่ตอน run
# Railway จะส่ง service variable เข้ามาเป็น build arg ให้ (ตั้งค่า NEXT_PUBLIC_API_URL ก่อน deploy)
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN pnpm --filter web build

ENV NODE_ENV=production
# next start เคารพ env PORT (Railway ฉีดให้) และ bind 0.0.0.0 อยู่แล้ว
WORKDIR /app/apps/web
CMD ["pnpm", "start"]
